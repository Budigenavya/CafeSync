# Copy these into the hosting provider's environment settings. Do not commit real values.
CAFESYNC_SECRET_KEY=generate-a-long-random-secret
CAFESYNC_ADMIN_PASSWORD=change-this-before-first-start
CAFESYNC_DATA_DIR=/var/data
# PostgreSQL is opt-in. Import the existing SQLite data first, then run
# `python migrate_postgres_delivery_schema.py` once to add delivery's rider
# schema. For verification, configure DATABASE_URL and set
# CAFESYNC_USE_POSTGRES=true in the verifier process environment.
# In Render, provide DATABASE_URL and CAFESYNC_SECRET_KEY before deploying.
CAFESYNC_USE_POSTGRES=false
DATABASE_URL=
CAFESYNC_DEBUG=false
ENABLE_SWIGGY=false
SWIGGY_API_KEY=
ENABLE_ZOMATO=false
ZOMATO_API_KEY=
